[Unit]
Description=aicoo Sky Eye file bridge
After=network-online.target sky-eye-export.service sky-eye-cry.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/aicoo/bridge.env
Environment=PYTHONUNBUFFERED=1
# User service; keep the same Linux user and state directory used for pairing.
# Change this checkout path if your backend repository is elsewhere.
ExecStart=/usr/bin/python3 %h/backend/raspberry-pi/start_aicoo.py
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
