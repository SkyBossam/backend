# Copy to .env for the local Docker Compose setup. Fill with independent random secrets.
DATABASE_PASSWORD=
JWT_SECRET=
WORKER_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production JAR deployment: export these variables through a secret manager.
# APP_ENV=production
# DATABASE_URL=jdbc:postgresql://database:5432/aicoo?sslmode=verify-full
# DATABASE_USER=aicoo
# MAIL_MODE=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MEDIA_GATEWAY_URL=https://your-media-gateway
# API_DOCS_ENABLED=false
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=file:/run/secrets/api.p12
# SERVER_SSL_KEY_STORE_PASSWORD=
# SERVER_SSL_KEY_STORE_TYPE=PKCS12
